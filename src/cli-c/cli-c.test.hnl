--- cli-c tests: pure surface (`sh_quote`, `argv`) plus spawn smoke
--- tests over `run`/`shell`. The exec cases need a working
--- posix_spawnp/sh on the host — they exercise real libc through the
--- ffi module.

from "./index" import * as m

test_sh_quote_plain := assert m.sh_quote("abc") = "'abc'"

test_sh_quote_empty := assert m.sh_quote("") = "''"

test_sh_quote_spaces := assert m.sh_quote("a b c") = "'a b c'"

test_sh_quote_embedded := assert m.sh_quote("it's") = "'it''\\'s'"

test_sh_quote_injection := assert m.sh_quote("x; rm -rf /") = "'x; rm -rf /'"

test_argv_prog_only := assert m.argv("echo", [], [], [], null, []) = ["echo"]

test_argv_subpath := assert m.argv("gh", ["pr", "create"], [], [], null, [])
  = ["gh", "pr", "create"]

test_argv_positionals := assert m.argv("add", [], ["a.txt", "b.txt"], [], null, [])
  = ["add", "a.txt", "b.txt"]

test_argv_flag_on := assert m.argv("gh", [], [],
  [{ name: "verbose", flag: "--verbose", kind: "flag" }],
  { verbose: true }, []) = ["gh", "--verbose"]

test_argv_flag_off := assert m.argv("gh", [], [],
  [{ name: "verbose", flag: "--verbose", kind: "flag" }],
  { verbose: false }, []) = ["gh"]

test_argv_flag_absent := assert m.argv("gh", [], [],
  [{ name: "verbose", flag: "--verbose", kind: "flag" }],
  {}, []) = ["gh"]

test_argv_string := assert m.argv("gh", ["pr", "create"], [],
  [{ name: "title", flag: "--title", kind: "string" }],
  { title: "hi there" }, []) = ["gh", "pr", "create", "--title", "hi there"]

test_argv_int := assert m.argv("tool", [], ["in"],
  [{ name: "n", flag: "-n", kind: "int" }],
  { n: 3 }, []) = ["tool", "in", "-n", "3"]

test_argv_strings := assert m.argv("tool", [], [],
  [{ name: "tag", flag: "-t", kind: "strings" }],
  { tag: ["a", "b"] }, []) = ["tool", "-t", "a", "-t", "b"]

test_argv_rest := assert m.argv("tool", [], ["f"], [], null, ["--", "x"])
  = ["tool", "f", "--", "x"]

test_argv_null_opts := assert m.argv("t", [], ["p"],
  [{ name: "x", flag: "--x", kind: "string" }], null, []) = ["t", "p"]

test_argv_mixed := assert m.argv("gh", ["pr", "create"], ["main"],
  [{ name: "title", flag: "--title", kind: "string" },
   { name: "draft", flag: "--draft", kind: "flag" },
   { name: "label", flag: "--label", kind: "strings" }],
  { title: "x", draft: true, label: ["bug", "cli"] }, ["extra"])
  = ["gh", "pr", "create", "main", "--title", "x", "--draft",
     "--label", "bug", "--label", "cli", "extra"]

--- spawn: `echo` exits 0 and stdout is captured.
test_run_echo := assert tag.untag(m.run(["echo", "hi"])).value.stdout = "hi\n"

test_run_echo_code := assert tag.untag(m.run(["echo", "hi"])).value.code = 0

--- spawn: the child's exit status passes through (sh exits 3).
test_run_code := assert tag.untag(m.run(["sh", "-c", "exit 3"])).value.code = 3

--- spawn: stdout and stderr are separate pipes.
test_run_stderr := assert tag.untag(m.run(["sh", "-c", "echo o; echo e >&2"])).value.stderr = "e\n"

test_run_stdout := assert tag.untag(m.run(["sh", "-c", "echo o; echo e >&2"])).value.stdout = "o\n"

--- spawn: argv goes verbatim — spaces stay inside one word, and shell
--- metacharacters are literal (no `sh` parses the argv).
test_run_word := assert tag.untag(m.run(["echo", "a b"])).value.stdout = "a b\n"

test_run_metachars := assert tag.untag(m.run(["echo", "a; b | c > d"])).value.stdout
  = "a; b | c > d\n"

--- spawn: a missing program is a spawn error — posix_spawnp reports the
--- ENOENT (2) itself now that no shell stands in between.
test_run_missing := assert tag.tag_of(m.run(["no-such-command-xyzzy"])) = "err"

test_run_missing_code := assert tag.untag(m.run(["no-such-command-xyzzy"])).value.code = 2

--- spawn: stdout larger than the 64 KiB pipe buffer — the poll drain
--- must keep pulling while the child is still writing.
test_run_big := assert str.length(tag.untag(m.run(["sh", "-c", "head -c 100000 /dev/zero | tr '\\0' 'x'"])).value.stdout)
  = 100000

--- spawn: empty argv is an `err(Spawn)` — EINVAL, no process ran.
test_run_empty := assert tag.tag_of(m.run([])) = "err"

--- shell: a raw pipeline line runs verbatim under `sh -c`.
test_shell_pipe := assert tag.untag(m.shell("echo ab | tr ab AB")).value.stdout
  = "AB\n"
