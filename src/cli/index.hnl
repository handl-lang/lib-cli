--- cli -- child-process spawn contract (port package).
---
--- `cli` is the *port*: it declares the types and arrow signatures every
--- CLI-process backend implements. `cli-c` (the sibling module in this
--- repo) is the reference backend over libc — a direct `posix_spawnp`
--- (no `sh -c`) with stdout/stderr captured through `pipe2` pairs wired
--- by spawn file-actions and drained via `poll`.
---
--- Surface:
---   run(argv)                                  -- spawn argv[0] via PATH,
---                                                 capture stdio + code
---   shell(cmdline)                             -- a raw `sh -c` line
---                                                 (caller-trusted input)
---   argv(prog, subpath, positionals, flag_specs, opts, rest)
---                                              -- pure argv assembly
---                                                 (Result: validation)
---   check(flag_specs, opts)                    -- pure opts-key
---                                                 validation
---   sh_quote(s)                                -- pure POSIX single-quote
---                                                 escaper
---
--- `run`/`shell` return `Result<Output, Spawn>`: `ok` carries a finished
--- child's `{ code, stdout, stderr }`; `err` carries a spawn-time failure
--- `{ code, message }` where `code` is the C errno. The child's own exit
--- status is never an `err` — it lands in `Output.code` (a signal death
--- is reported as `128 + signo`, the shell convention).
---
--- `~[1]~>` marks `run`/`shell` effectful: every backend reaches the OS
--- process interface through `ffi.call` (or the host equivalent).
--- `argv`/`check`/`sh_quote` are pure so the argv shape and the
--- option-validation policy are testable without a process table.
---
--- `argv`/`check` fail on *unknown* `opts` keys — a key that names no
--- spec in `flag_specs` (a typo'd `{ labl: "x" }` silently dropping
--- `--label` is the motivating case). The error reuses the `Spawn`
--- shape with a synthetic `code` (EINVAL, 22 — no C call ran) and a
--- `message` listing each unknown key plus a `did you mean` hint when
--- a spec name is close. `run` accepts `argv`'s `Result` directly and
--- propagates the `err` — generated adapters that write
--- `run(argv(...))` get call-time validation with no adapter change.
---
--- Composing output: `Output.stdout`/`stderr` are plain `String`s — the
--- caller composes existing pure arrows over them. This port ships no
--- `Output` methods (no `x.json()`: method adapters are not composable,
--- not treeshakeable, and would blur the purity line). The recipe is
--- free functions:
---
---   from "json" import { parse }          -- lib-json: String ~> Value
---   from "str-handl" import { lines }     -- str-handl: String ~> [String]
---
---   r := gh_config_list()                  -- adapter call → ok Output
---   v := parse(r.value.stdout)  -- --json stdout → Value
---   ls := lines(r.value.stdout) -- line-oriented stdout
---
--- `parse` is lenient, not validating: empty/garbage/unclosed input
--- returns `null`, and junk trailing a complete value yields `null`
--- too (the last top-level value wins). One input class *raises*: a
--- stray unmatched closer (`}`/`]`) with an empty frame stack fails
--- `match: no arm matched` — an eval error, not an `err`-tagged
--- result. For stdout you asked for (`--json` was passed), compose
--- directly; for untrusted text, guard the call.

from "result" import { Result }
from "type" import { Int, String, Obj, Value }

--- A finished child: exit `code` plus the captured streams decoded as
--- UTF-8. `code` is the wait status decoded the POSIX way — the exit
--- status when the child exited, `128 + signo` on signal death.
export Output := { code: Int, stdout: String, stderr: String }

--- A spawn-time failure: `code` is the C `errno` of the failing call
--- (`pipe2`/`malloc`/`posix_spawn_file_actions_*`/`posix_spawnp`/
--- `fcntl`/`poll`/`read`/`waitpid`), `message` names the call and the
--- `strerror` text when available.
export Spawn := { code: Int, message: String }

--- One command-line option spec for `argv`. `name` is the key looked up
--- in the `opts` record; `flag` is the literal argv word emitted when the
--- option is present; `kind` selects the emission shape:
---
---   "flag"    -- Boolean; emits `flag` iff the value is truthy
---   "string"  -- emits `flag <value>` (value stringified)
---   "int"     -- emits `flag <value>` (value stringified)
---   "strings" -- value is a list; emits `flag <v>` once per element
---
--- The `kind` spellings match the `opt:<kind>:<name>:<flag>` arg
--- descriptors the `cli` codegen emitter produces (`opt:string:title:--title`
--- lowers to `{ name: "title", flag: "--title", kind: "string", doc: "" }` —
--- the descriptor's optional trailing `:doc` component, empty when the
--- probe learned no description).
---
--- `doc` is the option's one-line description as read from the tool's
--- help table — empty (`""`) when the probe could not learn one. It is
--- documentation only: `argv`/`check` ignore it, so a spec with `doc`
--- set behaves identically to one without it. Generated adapters carry
--- it so the emitted SDK docs can render an option table without a
--- second trip through the tool's help.
export FlagSpec := { name: String, flag: String, kind: String, doc: String }

--- Spawn `argv[0]` (PATH lookup) with the rest as arguments, wait for
--- the child, and capture both streams. The argv array is literal — it
--- goes to `execvp` verbatim with no shell in between, so elements
--- containing spaces or shell metacharacters stay one word and `run`
--- is injection-free by construction.
---
--- Besides a literal `[String]`, a conforming backend accepts the
--- `Result<[String], Spawn>` `argv` returns: an `err` short-circuits to
--- `err(Spawn)` with no spawn attempted, an `ok` payload is spawned as
--- the literal argv.
export Run := ([String]) ~>[1] Result<Output, Spawn>

--- Pure option validation: `check(flag_specs, opts)` returns
--- `ok(null)` when every key in `opts` names a spec in `flag_specs`
--- (`opts` may be `null`, which always passes), and `err(Spawn)` —
--- `code` EINVAL, `message` listing each unknown key with a
--- `did you mean` hint when a spec name is within the backend's
--- suggestion threshold (edit distance or prefix match) — otherwise.
export Check := ([FlagSpec], Obj) ~> Result<Value, Spawn>

--- Pure argv assembly:
---
---   argv(prog, subpath, positionals, flag_specs, opts, rest)
---
--- emits `ok([prog] ++ subpath ++ positionals ++ flags ++ rest)` with
--- every element stringified (`type.to_string`, so Int/Bool positionals
--- and option values are safe). `subpath` is the command path after the
--- program word (e.g. `["pr", "create"]` for `gh pr create`); `opts` is
--- an `Obj` record (or `null`) expanded against `flag_specs`; `rest` is
--- the variadic tail appended verbatim. `check` runs first: an `opts`
--- key with no matching spec returns the `check` error instead of a
--- word list.
export Argv := (String, [String], [Value], [FlagSpec], Obj, [Value])
  ~> Result<[String], Spawn>

--- POSIX single-quote escaping: wraps `s` in `'` and replaces each inner
--- `'` with `'\''`, so the result is one argv word under POSIX shell
--- tokenization for any input. Pure — `run` no longer composes it
--- (argv is not shell-parsed); it remains for callers that build
--- `sh -c` lines themselves (generated adapters, `shell` callers).
export ShQuote := (String) ~> String

--- Run a raw `sh -c` command line — no quoting, full shell syntax
--- (pipes, redirections, `&&`). The input is caller-trusted: never pass
--- untrusted text (use `run` + `argv`/`sh_quote` for that).
export Shell := (String) ~>[1] Result<Output, Spawn>

--- `argv` always emits `prog` as argv[0] on the `ok` path: the builder
--- followed by an untag plus `[0]` projection is the same arrow as the
--- first projection of its inputs. Quantified over the `Argv` signature
--- so any conforming backend can be checked against it.
export argv_head := (argv: Argv) ~>
  (prog, subpath, positionals, flag_specs, opts, rest) ~>
    argv(prog, subpath, positionals, flag_specs, opts, rest).value[0]
  ~[2]~>
  (prog, subpath, positionals, flag_specs, opts, rest) ~> prog
